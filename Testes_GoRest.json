      "name": "1. User Management",
      "item": [
        {
          "name": "1_CreateUser",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code deve ser 201 Created\", function () {\n    pm.response.to.have.status(201);\n});\nconst resposta = pm.response.json();\npm.environment.set(\"user_id\", resposta.id);\npm.environment.set(\"user_name\", resposta.name);\npm.test(\"Validar se o ID foi gerado corretamente\", function () {\n    pm.expect(resposta.id).to.be.a('number');\n});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{$randomFullName}}\",\n  \"gender\": \"male\",\n  \"email\": \"{{$randomEmail}}\",\n  \"status\": \"active\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users"
              ]
            }
          },
          "response": []
        },
        {
          "name": "2_SearchUser",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code deve ser 200 OK\", function () {\n    pm.response.to.have.status(200);\n});\nconst resposta = pm.response.json();\nconst idBuscado = pm.environment.get(\"user_id\");\npm.test(`O usuário retornado deve ter o ID ${idBuscado}`, function () {\n    pm.expect(resposta.id).to.equal(idBuscado);\n});\npm.test(\"A resposta deve conter a estrutura correta (id, name, email, gender, status)\", function () {\n    pm.expect(resposta).to.have.property('id');\n    pm.expect(resposta).to.have.property('name');\n    pm.expect(resposta).to.have.property('email');\n    pm.expect(resposta).to.have.property('gender');\n    pm.expect(resposta).to.have.property('status');\n});\npm.test(\"O tempo de resposta deve ser menor que 1000ms\", function () {\n    pm.expect(pm.response.responseTime).to.be.below(1000);\n});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/{{user_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                "{{user_id}}"
              ]
            }
          },
          "response": []
